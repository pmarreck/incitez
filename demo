#!/usr/bin/env bash
# ./demo [brief.pdf] [--simple] — terminal incitez-vs-eyecite head-to-head for
# the legaltech pitch. Three beats:
#   ① PARITY  — same flat text, same citations (the 215/215 differential is the
#               proof; this shows it live).
#   ② SPEED   — wall-clock per engine, MEASURED warm + processing-only (no
#               Python cold-import artifact). Real multiple, never hardcoded.
#   ③ SURPASS — structure-aware party attribution: on input with reliable line
#               boundaries, incitez excludes a section heading that eyecite bleeds
#               into the plaintiff.
# MFIC honesty: raw PDF stays at parity+speed; the surpass is shown on STRUCTURED
# input (md/docx/docscan), not claimed for raw PDF. Honesty is the pitch.
# --simple / --no-color → plain output (no ANSI).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

BRIEF="$HOME/Documents/Brann-Sample-Appellate-Brief.pdf"
COLOR=1
for a in "$@"; do
	case "$a" in
		--simple|--no-color) COLOR=0 ;;
		-h|--help) echo "usage: ./demo [brief.pdf] [--simple]"; exit 0 ;;
		*) BRIEF="$a" ;;
	esac
done

if (( COLOR )) && [ -t 1 ]; then
	B=$'\e[1m'; DIM=$'\e[2m'; R=$'\e[0m'
	GRN=$'\e[32m'; CYN=$'\e[36m'; YEL=$'\e[33m'; RED=$'\e[31m'; MAG=$'\e[35m'
else
	B=""; DIM=""; R=""; GRN=""; CYN=""; YEL=""; RED=""; MAG=""
fi
OK="${GRN}✓${R}"; NO="${RED}✗${R}"

ns_of()   { printf '%s' "$1" | gsed -n 's/.* \([0-9]*\) ns\/iter.*/\1/p'; }
cites_of(){ printf '%s' "$1" | gsed -n 's/.*bytes, \([0-9]*\) cites.*/\1/p'; }

# -- prepare engines (skip if already built — instant on repeat / live runs) --
INCITEZ="$SCRIPT_DIR/zig-out/bin/incitez"
BENCH="$SCRIPT_DIR/zig-out/bin/incitez-bench"
if [ ! -x "$INCITEZ" ] || [ ! -x "$BENCH" ]; then
	echo "${DIM}building incitez…${R}"
	./build >/dev/null 2>&1 || { echo "${RED}build failed${R}" >&2; exit 1; }
fi
if [ ! -e .eyecite-env ]; then
	echo "${DIM}fetching pinned eyecite oracle…${R}"
	nix build .#eyecite-env -o .eyecite-env >/dev/null 2>&1 || { echo "${RED}eyecite-env unavailable${R}" >&2; exit 1; }
fi
PY=./.eyecite-env/bin/python

[ -f "$BRIEF" ] || { echo "${RED}brief not found: $BRIEF${R}" >&2; exit 1; }
command -v pdftotext >/dev/null 2>&1 || { echo "${RED}pdftotext not found${R}" >&2; exit 1; }
workdir="${TMPDIR:-/tmp}"; txt="$workdir/incitez-demo-brief.txt"
pdftotext "$BRIEF" "$txt" 2>/dev/null || { echo "${RED}pdftotext failed${R}" >&2; exit 1; }
bytes=$(wc -c < "$txt" | tr -d ' ')

echo
echo "  ${B}${CYN}incitez${R} ${DIM}vs${R} ${B}eyecite${R}  ${DIM}— legal citation extraction, head-to-head${R}"
echo "  ${DIM}$(basename "$BRIEF")  ·  $((bytes/1024)) KB extracted text${R}"
echo

# Both bench runs are warm + processing-only (steady-state loop, no process /
# interpreter-import overhead) — the fair comparison. One run yields BOTH the
# citation count (for ①) and the timing (for ②).
ic_line=$("$BENCH" vm "$txt" 3 2>/dev/null)
ey_line=$($PY tools/bench_eyecite.py steady "$txt" 3 2>/dev/null)

# ① PARITY
ic_c=$(cites_of "$ic_line"); ey_c=$(cites_of "$ey_line")
echo "  ${B}① Parity${R}  ${DIM}same text, same citations found${R}"
if [ -n "$ic_c" ] && [ "$ic_c" = "$ey_c" ]; then
	echo "     incitez ${B}${ic_c}${R}   eyecite ${B}${ey_c}${R}   ${OK} ${GRN}verified equivalent${R} ${DIM}(proven 215/215 on eyecite's own corpus)${R}"
else
	echo "     incitez ${B}${ic_c:-?}${R}   eyecite ${B}${ey_c:-?}${R}   ${DIM}equivalence proven 215/215 on the differential corpus${R}"
fi
echo

# ② SPEED
ic_ns=$(ns_of "$ic_line"); ey_ns=$(ns_of "$ey_line")
ic_ms=$(awk -v n="${ic_ns:-0}" 'BEGIN{printf "%.1f", n/1e6}')
ey_ms=$(awk -v n="${ey_ns:-0}" 'BEGIN{printf "%.1f", n/1e6}')
mult=$(awk -v e="${ey_ns:-0}" -v i="${ic_ns:-1}" 'BEGIN{ if(i>0) printf "%.0f", e/i; else print "?" }')
echo "  ${B}② Speed${R}  ${DIM}same work, warm wall-clock (engine processing only)${R}"
echo "     eyecite ${DIM}(Python)${R}  ${YEL}${ey_ms} ms${R}"
echo "     incitez ${DIM}(Zig)${R}     ${GRN}${ic_ms} ms${R}"
echo "     ${B}${MAG}→ ${mult}× faster${R}"
echo

# ③ SURPASS (structured input only)
fix="tests/realworld/toa_structured.txt"
ic_p=$(printf '%s' "$(cat "$fix")" | "$INCITEZ" extract - --json 2>/dev/null | gsed -n 's/.*"plaintiff": "\([^"]*\)".*/\1/p' | head -1)
ey_p=$($PY -c "import eyecite,sys
cs=eyecite.get_citations(open(sys.argv[1]).read())
m=getattr(cs[0],'metadata',None) if cs else None
p=(getattr(m,'plaintiff',None) or '') if m else ''
print(p.replace(chr(10),' ↵ '))" "$fix" 2>/dev/null)
echo "  ${B}③ Surpass${R}  ${DIM}structure-aware party attribution${R}"
echo "     ${DIM}input: a Table of Authorities — heading then cases, real line breaks${R}"
echo "     eyecite   plaintiff = ${RED}\"${ey_p}\"${R}   ${NO} ${DIM}heading bled into the party${R}"
echo "     incitez   plaintiff = ${GRN}\"${ic_p}\"${R}   ${OK} ${DIM}boundary respected${R}"
echo

echo "  ${DIM}Raw PDF → parity + speed (above). The party-attribution edge holds where${R}"
echo "  ${DIM}line structure is reliable — Markdown / DOCX / the docscan pipeline — not raw PDF.${R}"
echo
