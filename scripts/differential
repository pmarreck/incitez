#!/usr/bin/env bash
# Differential gate: incitez (VM engine) vs LIVE pinned eyecite over the
# combined corpus text set, with the expected-divergence ledger
# (tests/expected_divergences.json) providing fenced exceptions.
# Exit nonzero on unfenced divergence or stale/dead fences.
#
# Delegates to the sandboxed flake check (`checks.<system>.differential`) — the
# SAME derivation Garnix runs — instead of building in the dev shell. The old
# `nix develop -c zig build` path is broken where Zig's bundled libSystem stubs
# don't cover the host OS (e.g. macOS 26.x: "failed to spawn build runner …
# FileNotFound"). A dirty git worktree is still tested: nix copies uncommitted
# changes to TRACKED files (with a "Git tree is dirty" warning); only untracked
# files are excluded. `-L` streams the in-derivation "NNN/NNN agree, … unfenced"
# result line.
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/.." || exit 1

system="$(nix eval --raw --impure --expr 'builtins.currentSystem')"
exec nix build ".#checks.${system}.differential" -L
