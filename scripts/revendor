#!/usr/bin/env bash
# Re-vendor citation databases from the flake-pinned upstream sources into
# data/ (tracked). The flake.lock is the pin; this copies the JSON we build
# from, plus license texts, and regenerates data/PROVENANCE.md.
# Workflow for a data refresh:
#   nix flake update reporters-db-src courts-db-src eyecite-src
#   ./scripts/link-deps && ./scripts/revendor && ./test   # then jj commit
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR/.." || exit 1

for dep in eyecite-src reporters-db-src courts-db-src; do
	if [[ ! -d "deps/$dep" ]]; then
		echo "FAILED: deps/$dep missing — run scripts/link-deps first" >&2
		exit 1
	fi
done

run() {
	"$@" || {
		echo "FAILED: $*" >&2
		exit 1
	}
}

mkdir -p data/reporters_db data/courts_db

# reporters-db: everything eyecite consumes (json only; csv is redundant)
for f in reporters.json regexes.json laws.json journals.json \
	state_abbreviations.json case_name_abbreviations.json; do
	run cp -f "deps/reporters-db-src/reporters_db/data/$f" "data/reporters_db/$f"
done

# courts-db: courts list + the variables used to expand its regex templates
for f in courts.json variables.json; do
	run cp -f "deps/courts-db-src/courts_db/data/$f" "data/courts_db/$f"
done

chmod -R u+w data/

# Exact upstream license texts, kept verbatim
{
	echo "Third-party licenses for data and test material vendored into incitez."
	echo "All upstream projects are by the Free Law Project (https://free.law)."
	echo
	for dep in eyecite reporters-db courts-db; do
		echo "================================================================"
		echo "== $dep (https://github.com/freelawproject/$dep)"
		echo "================================================================"
		cat "deps/${dep}-src/LICENSE"
		echo
	done
} > THIRD_PARTY_LICENSES

# Provenance: versions + locked revisions, machine-readable-ish
{
	echo "# Vendored data provenance"
	echo
	echo "Generated by scripts/revendor on $(date '+%Y-%m-%d') from flake-pinned inputs."
	echo "The pins live in flake.lock; deps/ symlinks point at the store paths."
	echo
	for dep in eyecite reporters-db courts-db; do
		ver=$(sed -n 's/^version = "\(.*\)"/\1/p' "deps/${dep}-src/pyproject.toml" | head -1)
		rev=$(nix flake metadata --json 2>/dev/null |
			nix run 'nixpkgs#jq' -- -r ".locks.nodes.\"${dep}-src\".locked.rev")
		echo "- **$dep** $ver (rev \`$rev\`) — BSD-2-Clause"
	done
} > data/PROVENANCE.md

echo "Vendored:"
find data -type f | sort
