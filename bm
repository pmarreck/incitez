#!/usr/bin/env bash
# Engine benchmark: vm vs pcre2 over a synthetic legal document assembled
# from the acceptance corpus. Results append to BENCHMARKS.md (committed,
# hardware-keyed). Always ReleaseFast (the bench binary refuses Debug).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

run() {
	"$@" || {
		echo "FAILED: $*" >&2
		exit 1
	}
}

run ./build

workdir="${TMPDIR:-/tmp}"
base="$workdir/incitez-bench-base.txt"
doc="$workdir/incitez-bench.txt"

run nix run 'nixpkgs#jq' -- -r '.methods[][] | .text' tests/corpus/eyecite_corpus.json > "$base"
: > "$doc"
for _ in $(seq 1 150); do cat "$base" >> "$doc"; done
bytes=$(wc -c < "$doc" | tr -d ' ')

echo "=== steady-state (in-process, 5 iters) ==="
vm_line=$(./zig-out/bin/incitez-bench vm "$doc" 5)
p2_line=$(./zig-out/bin/incitez-bench pcre2 "$doc" 5)
echo "$vm_line"
echo "$p2_line"

echo "=== one-shot incl. startup + engine init (hyperfine) ==="
hf_json="$workdir/incitez-bench-hf.json"
run nix develop -c hyperfine -N --warmup 3 \
	--export-json "$hf_json" \
	"./zig-out/bin/incitez-bench vm $doc 1" \
	"./zig-out/bin/incitez-bench pcre2 $doc 1"

vm_oneshot=$(nix run 'nixpkgs#jq' -- -r '.results[0].mean' "$hf_json")
p2_oneshot=$(nix run 'nixpkgs#jq' -- -r '.results[1].mean' "$hf_json")

hw="$(uname -m)-$(sysctl -n machdep.cpu.brand_string 2>/dev/null || uname -s)"

# Two-sided gate: ±10% vs the most recent committed entry for this hardware.
# A sudden speedup is ALSO a failure until explained (house rules); rerunning
# after review is implicit acceptance since every run appends a new baseline.
gate_status=0
vm_ns=$(printf '%s' "$vm_line" | gsed -n 's/.* \([0-9]*\) ns\/iter.*/\1/p')
prev_ns=$(awk -v hw="$hw" '
	/^## / { keep = index($0, hw) > 0 }
	keep && /^vm: / { match($0, /[0-9]+ ns\/iter/); ns = substr($0, RSTART, RLENGTH - 8) }
	END { print ns }
' BENCHMARKS.md 2>/dev/null)
if [[ -n "${prev_ns:-}" && -n "${vm_ns:-}" && "$prev_ns" -gt 0 ]]; then
	delta_pct=$(( (vm_ns - prev_ns) * 100 / prev_ns ))
	if (( delta_pct > 10 || delta_pct < -10 )); then
		echo ""
		printf '\033[1;31mBENCHMARK GATE: vm %s%% vs previous baseline (%s -> %s ns/iter) — outside ±10%%!\033[0m\n' "$delta_pct" "$prev_ns" "$vm_ns"
		echo "Investigate before accepting; this run is now the recorded baseline."
		gate_status=1
	else
		echo "benchmark gate: vm ${delta_pct}% vs baseline (within ±10%)"
	fi
fi
{
	echo "## $(date '+%Y-%m-%d %H:%M') — $hw — ${bytes} bytes input"
	echo '```'
	echo "$vm_line"
	echo "$p2_line"
	echo "one-shot mean: vm ${vm_oneshot}s, pcre2 ${p2_oneshot}s"
	echo '```'
	echo
} >> BENCHMARKS.md

echo "appended to BENCHMARKS.md"
exit "$gate_status"
