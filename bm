#!/usr/bin/env bash
# Benchmark suite. Two sections, both appended to BENCHMARKS.md (committed,
# hardware-keyed). Always ReleaseFast (the bench binary refuses Debug).
#
#   1. VM regression: incitez VM over a large synthetic doc (~1.7MB,
#      citation-dense), with a two-sided +/-10% gate vs the last baseline for
#      this hardware. This is the metric that guards against perf drift; a
#      sudden speedup is ALSO a failure until explained (house rules).
#      (pcre2 is NOT run on the big doc -- its all-extractors-over-full-text
#      cost is pathological there [~37s/iter] and meaningless as a startup
#      number; it is measured on the tractable mid doc below.)
#
#   2. vs eyecite: incitez VM vs pinned eyecite (default ahocorasick
#      tokenizer) -- the headline "Nx faster" number -- on an eyecite-
#      tractable doc (~116KB): steady-state throughput, cold-start single-
#      invocation latency, and a cite-count agreement check. pcre2 is shown
#      here too (our brute-force path, for contrast).
#
# Pass --no-eyecite to skip section 2 (faster local iteration / offline).
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR" || exit 1

with_eyecite=1
[[ "${1:-}" == "--no-eyecite" ]] && with_eyecite=0

run() {
	"$@" || {
		echo "FAILED: $*" >&2
		exit 1
	}
}

ns_of() { printf '%s' "$1" | gsed -n 's/.* \([0-9]*\) ns\/iter.*/\1/p'; }
cites_of() { printf '%s' "$1" | gsed -n 's/.*bytes, \([0-9]*\) cites.*/\1/p'; }

run ./build

workdir="${TMPDIR:-/tmp}"
base="$workdir/incitez-bench-base.txt"
big="$workdir/incitez-bench.txt"

run nix run 'nixpkgs#jq' -- -r '.methods[][] | .text' tests/corpus/eyecite_corpus.json > "$base"
: > "$big"
for _ in $(seq 1 150); do cat "$base" >> "$big"; done
big_bytes=$(wc -c < "$big" | tr -d ' ')

hw="$(uname -m)-$(sysctl -n machdep.cpu.brand_string 2>/dev/null || uname -s)"

# -- Section 1: VM regression (gate) --
echo "=== VM regression: steady-state (${big_bytes} bytes, 5 iters) ==="
vm_line=$(./zig-out/bin/incitez-bench vm "$big" 5)
echo "$vm_line"

echo "=== VM one-shot incl. startup + table load (hyperfine) ==="
hf_json="$workdir/incitez-bench-hf.json"
run nix develop -c hyperfine -N --warmup 3 --export-json "$hf_json" \
	"./zig-out/bin/incitez-bench vm $big 1"
vm_oneshot=$(nix run 'nixpkgs#jq' -- -r '.results[0].mean' "$hf_json")

# Two-sided gate: +/-10% vs the most recent committed vm entry for this hw.
gate_status=0
vm_ns=$(ns_of "$vm_line")
prev_ns=$(awk -v hw="$hw" '
	/^## / { keep = index($0, hw) > 0 }
	keep && /^vm: / { match($0, /[0-9]+ ns\/iter/); ns = substr($0, RSTART, RLENGTH - 8) }
	END { print ns }
' BENCHMARKS.md 2>/dev/null)
if [[ -n "${prev_ns:-}" && -n "${vm_ns:-}" && "$prev_ns" -gt 0 ]]; then
	delta_pct=$(( (vm_ns - prev_ns) * 100 / prev_ns ))
	if (( delta_pct > 10 || delta_pct < -10 )); then
		echo ""
		printf '\033[1;31mBENCHMARK GATE: vm %s%% vs previous baseline (%s -> %s ns/iter) -- outside +/-10%%!\033[0m\n' "$delta_pct" "$prev_ns" "$vm_ns"
		echo "Investigate before accepting; this run is now the recorded baseline."
		gate_status=1
	else
		echo "benchmark gate: vm ${delta_pct}% vs baseline (within +/-10%)"
	fi
fi

# -- Section 2: vs eyecite --
eyecite_block=""
if (( with_eyecite )); then
	if nix build .#eyecite-env -o .eyecite-env >/dev/null 2>&1; then
		PY=./.eyecite-env/bin/python
		mid="$workdir/incitez-bench-mid.txt"
		: > "$mid"
		for _ in $(seq 1 10); do cat "$base" >> "$mid"; done
		mid_bytes=$(wc -c < "$mid" | tr -d ' ')

		echo ""
		echo "=== vs eyecite: steady-state (${mid_bytes} bytes) ==="
		ec_vm=$(./zig-out/bin/incitez-bench vm "$mid" 20)
		ec_p2=$(./zig-out/bin/incitez-bench pcre2 "$mid" 3)
		ec_ey=$($PY tools/bench_eyecite.py steady "$mid" 3 2>/dev/null)
		echo "$ec_vm"
		echo "$ec_p2"
		echo "$ec_ey"

		vm_ns2=$(ns_of "$ec_vm"); ey_ns=$(ns_of "$ec_ey")
		vm_cites=$(cites_of "$ec_vm"); ey_cites=$(cites_of "$ec_ey")
		speedup="?"
		[[ -n "$vm_ns2" && -n "$ey_ns" && "$vm_ns2" -gt 0 ]] &&
			speedup=$(awk -v a="$ey_ns" -v b="$vm_ns2" 'BEGIN{printf "%.1f", a/b}')
		echo "  steady-state: VM ${speedup}x faster than eyecite  (cites: vm ${vm_cites:-?} vs eyecite ${ey_cites:-?})"

		base_bytes=$(wc -c < "$base" | tr -d ' ')
		echo "=== vs eyecite: cold-start single invocation (${base_bytes} bytes) ==="
		cold_json="$workdir/incitez-bench-cold.json"
		cold_line=""
		if nix develop -c hyperfine -N --warmup 2 --export-json "$cold_json" \
			"./zig-out/bin/incitez extract $base" \
			"$PY tools/bench_eyecite.py oneshot $base" >/dev/null 2>&1; then
			ic_cold=$(nix run 'nixpkgs#jq' -- -r '.results[0].mean' "$cold_json")
			ey_cold=$(nix run 'nixpkgs#jq' -- -r '.results[1].mean' "$cold_json")
			cold_x=$(awk -v a="$ey_cold" -v b="$ic_cold" 'BEGIN{printf "%.1f", a/b}')
			echo "  cold-start: incitez ${ic_cold}s vs eyecite ${ey_cold}s  (${cold_x}x faster)"
			cold_line=$(printf '  cold-start single invocation (%s bytes): incitez %ss vs eyecite %ss = %sx faster' \
				"$base_bytes" "$ic_cold" "$ey_cold" "$cold_x")
		else
			cold_line="  cold-start: skipped (hyperfine run failed)"
		fi

		eyecite_block=$(printf 'vs eyecite (default tokenizer), %s bytes:\n  steady-state: vm %s ns/iter vs eyecite %s ns/iter = %sx faster (pcre2 %s ns/iter)\n%s\n  cite agreement: vm %s vs eyecite %s' \
			"$mid_bytes" "${vm_ns2:-?}" "${ey_ns:-?}" "$speedup" "$(ns_of "$ec_p2")" "$cold_line" "${vm_cites:-?}" "${ey_cites:-?}")
	else
		echo "vs-eyecite: skipped (eyecite-env unavailable -- offline?)" >&2
	fi
fi

# -- Section 3: per-key-function microbench (CLAUDE.md L32 — log over key
# functions, LOUDLY flag deltas). A single end-to-end number once hid a
# referenceScan O(cites×text) quadratic until it dominated; per-function
# history catches such regressions at the function boundary. Two-sided gate
# vs the most recent MICROBENCHMARKS.md entry for this hardware.
micro_doc="$workdir/incitez-micro.txt"
: > "$micro_doc"
for _ in $(seq 1 10); do cat "$base" >> "$micro_doc"; done
micro_bytes=$(wc -c < "$micro_doc" | tr -d ' ')

echo ""
echo "=== per-key-function microbench (${micro_bytes} bytes, 20 iters) ==="
micro_out=$(./zig-out/bin/incitez-bench micro "$micro_doc" 20)
echo "$micro_out"

MICRO_TOL=25
prev_micro() {  # $1 = phase name -> most recent committed ns for this hw
	awk -v hw="$hw" -v ph="$1" '
		/^## / { keep = index($0, hw) > 0 }
		keep && $1 == ph":" { val = $2 }
		END { print val }
	' MICROBENCHMARKS.md 2>/dev/null
}

micro_block=""
while IFS= read -r line; do
	[[ "$line" == *"ns/iter"* ]] || continue
	phase=${line%%:*}
	ns=$(printf '%s' "$line" | gsed -n 's/.*: \([0-9]*\) ns\/iter.*/\1/p')
	[[ -z "$ns" ]] && continue
	micro_block+="${phase}: ${ns}"$'\n'
	prev=$(prev_micro "$phase")
	if [[ -n "$prev" && "$prev" -gt 0 ]]; then
		d=$(( (ns - prev) * 100 / prev ))
		if (( d > MICRO_TOL || d < -MICRO_TOL )); then
			printf '\033[1;31mMICRO GATE: %s %s%% vs baseline (%s -> %s ns/iter) -- outside ±%s%%!\033[0m\n' \
				"$phase" "$d" "$prev" "$ns" "$MICRO_TOL"
			gate_status=1
		else
			echo "  micro gate: ${phase} ${d}% (within ±${MICRO_TOL}%)"
		fi
	fi
done <<< "$micro_out"

{
	echo "## $(date '+%Y-%m-%d %H:%M') -- $hw -- ${micro_bytes} bytes input"
	printf '%s' "$micro_block"
	echo
} >> MICROBENCHMARKS.md
echo "appended to MICROBENCHMARKS.md"
# -- Record --
{
	echo "## $(date '+%Y-%m-%d %H:%M') -- $hw -- ${big_bytes} bytes input"
	echo '```'
	echo "$vm_line"
	echo "one-shot mean: vm ${vm_oneshot}s"
	[[ -n "$eyecite_block" ]] && printf '%s\n' "$eyecite_block"
	echo '```'
	echo
} >> BENCHMARKS.md

echo "appended to BENCHMARKS.md"
exit "$gate_status"
